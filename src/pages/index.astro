---
import ChatBot from './chatBot.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Datos al Ecosistema 2026</title>
</head>
<body>

    <header class="navbar">
        <div class="logo-container">
            <img src="/logo.png" alt="Logo Hormiga" class="logo-img" />
        </div>

        <nav class="nav-links">
            <a href="/" class="nav-link">Inicio</a>
            
            <a href="/fuentes" class="nav-link">Datos</a>
        </nav>
    </header>

    <main class="main-content">
        <div class="info-block">
            <h1>Asistente Virtual para Datos Abiertos</h1>
            <p>
                Una plataforma interactiva diseñada para transformar datos presupuestales públicos complejos en información clara, accesible y navegable para cualquier ciudadano.
            </p>
        </div>

    </main>

    <footer class="footer">
        <a href="https://www.datos.gov.co/stories/s/Concurso-Datos-al-Ecosistema-2026-IA-para-Colombia/ddau-8cy9/#fase-2---selecci%C3%B3n-de-equipos-admitidos-y-desarrollo-" target="_blank" class="footer-link">
            Datos al Ecosistema 2026: IA para Colombia ♢
        </a>
    </footer>

    <ChatBot />

</body>
</html>

<style>
    :global(html), :global(body) {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: #D9D9D9;
        font-family: system-ui, -apple-system, sans-serif;
        
        background: linear-gradient(135deg, #121212, #35113b, #0f2b37, #121212, #9432ab, #4688a2);
        background-size: 400% 400%;
        animation: moverShaderSuave 12s ease infinite;
    }

    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    @keyframes moverShaderSuave {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(18, 18, 18, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .logo-container {
        display: flex;
        align-items: center;
    }

    .logo-img {
        height: 50px;
        width: auto;
        object-fit: contain;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-link {
        color: #D9D9D9;
        text-decoration: none;
        font-weight: bold;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        background-color: #69C6EA;
        color: #292929;
    }

    .main-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        position: relative;
    }

    .info-block {
        text-align: center;
        max-width: 700px;
        padding: 1rem;
    }

    .info-block h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #FE4DB1;
        text-shadow: 0 0 15px rgba(254, 77, 177, 0.4);
    }

    .info-block p {
        font-size: 1.1rem;
        color: #e2e2e2;
        line-height: 1.6;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    .floating-btn {
        position: absolute;
        bottom: 2rem;
        right: 2rem;
        background-color: #D9D9D9;
        color: #292929;
        font-weight: bold;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        transition: all 0.2s ease;
    }

    .floating-btn:hover {
        background-color: #69C6EA;
        transform: translateY(-2px);
    }

    .footer {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1rem;
        text-align: center;
        background: rgba(18, 18, 18, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .footer-link {
        color: #69C6EA;
        text-decoration: none;
        font-size: 0.875rem;
    }

    .footer-link:hover {
        text-decoration: underline;
    }
</style>

<script>
    
    const btnNav = document.querySelector('.nav-links a[href="#"]');
    const btnFloating = document.querySelector('.floating-btn');

    
    function abrirChat() {
        
        const chatContainer = document.querySelector('.chatbot-container') || document.querySelector('#chatbot-toggle');
        
        if (chatContainer) {
            
            chatContainer.classList.add('active'); 
            
            (chatContainer as HTMLElement).click();
        } else {
            console.log("Componente ChatBot detectado en el HTML, pero necesitas revisar qué ID o Clase usa dentro de chatBot.astro para abrirse.");
        }
    }

    
    btnNav?.addEventListener('click', (e) => { e.preventDefault(); abrirChat(); });
    btnFloating?.addEventListener('click', (e) => { e.preventDefault(); abrirChat(); });
</script>