---
import ChatBot from './chatBot.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Datos al Ecosistema 2026</title>
</head>
<body>

    <header class="navbar">
        <div class="logo-container">
            <img src="/logo.png" alt="Logo Hormiga" class="logo-img" />
        </div>

        <nav class="nav-links">
            <a href="/" id="nav-inicio" class="nav-link active-link">Inicio</a>
            <!-- Botón del Chatbot agregado a la Navbar (Se removió la sección de Datos) -->
            <button id="nav-chatbot" class="nav-link-btn">Chatbot</button>
        </nav>
    </header>

    <main class="main-content">
        <!-- Vista de Inicio Tradicional -->
        <div id="view-inicio" class="info-block">
            <h1>Asistente Virtual para Datos Abiertos</h1>
            <p>
                Una plataforma interactiva diseñada para transformar datos presupuestales públicos complejos en información clara, accesible y navegable para cualquier ciudadano.
            </p>
            <button id="btn-comenzar" class="action-btn">Comenzar a chatear</button>
        </div>

        <!-- Contenedor Pantalla Completa para el Chat -->
        <div id="view-chatbot" class="chat-full-screen hidden">
            <ChatBot />
        </div>
    </main>

    <footer class="footer">
        <a href="https://www.datos.gov.co/stories/s/Concurso-Datos-al-Ecosistema-2026-IA-para-Colombia/ddau-8cy9/#fase-2---selecci%C3%B3n-de-equipos-admitidos-y-desarrollo-" target="_blank" class="footer-link">
            Datos al Ecosistema 2026: IA para Colombia ♢
        </a>
    </footer>

</body>
</html>

<style>
    :global(html), :global(body) {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: #D9D9D9;
        font-family: system-ui, -apple-system, sans-serif;
        
        background: linear-gradient(135deg, #121212, #35113b, #0f2b37, #121212, #9432ab, #4688a2);
        background-size: 400% 400%;
        animation: moverShaderSuave 12s ease infinite;
    }

    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    @keyframes moverShaderSuave {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(18, 18, 18, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .logo-container {
        display: flex;
        align-items: center;
    }

    .logo-img {
        height: 50px;
        width: auto;
        object-fit: contain;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-link, .nav-link-btn {
        color: #D9D9D9;
        text-decoration: none;
        font-weight: bold;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
        background: none;
        border: none;
        font-size: 1rem;
        cursor: pointer;
    }

    .nav-link:hover, .nav-link-btn:hover, .active-link {
        background-color: #69C6EA;
        color: #292929;
    }

    .main-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        width: 100%;
    }

    .info-block {
        text-align: center;
        max-width: 700px;
        padding: 1rem;
    }

    .info-block h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #FE4DB1;
        text-shadow: 0 0 15px rgba(254, 77, 177, 0.4);
    }

    .info-block p {
        font-size: 1.1rem;
        color: #e2e2e2;
        line-height: 1.6;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        margin-bottom: 2rem;
    }

    .action-btn {
        background-color: #D9D9D9;
        color: #292929;
        font-weight: bold;
        padding: 0.75rem 2rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        transition: all 0.2s ease;
        font-size: 1rem;
    }

    .action-btn:hover {
        background-color: #69C6EA;
        transform: translateY(-2px);
    }

    /* Contenedor a pantalla completa para el chatbot */
    .chat-full-screen {
        width: 100%;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: calc(100vh - 150px);
        padding: 1rem;
        box-sizing: border-box;
    }

    .hidden {
        display: none !important;
    }

    .footer {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1rem;
        text-align: center;
        background: rgba(18, 18, 18, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .footer-link {
        color: #69C6EA;
        text-decoration: none;
        font-size: 0.875rem;
    }

    .footer-link:hover {
        text-decoration: underline;
    }
</style>

<script>
    const navInicio = document.getElementById('nav-inicio');
    const navChatbot = document.getElementById('nav-chatbot');
    const btnComenzar = document.getElementById('btn-comenzar');
    
    const viewInicio = document.getElementById('view-inicio');
    const viewChatbot = document.getElementById('view-chatbot');

    function mostrarChatbot() {
        viewInicio?.classList.add('hidden');
        viewChatbot?.classList.remove('hidden');
        
        navInicio?.classList.remove('active-link');
        navChatbot?.classList.add('active-link');

       
        const toggleBtnInterno = document.getElementById('chat-toggle-btn');
        if (toggleBtnInterno && !toggleBtnInterno.classList.contains('hidden')) {
            (toggleBtnInterno as HTMLElement).click();
        }
    }

    function mostrarInicio() {
        viewChatbot?.classList.add('hidden');
        viewInicio?.classList.remove('hidden');
        
        navChatbot?.classList.remove('active-link');
        navInicio?.classList.add('active-link');
    }

    navChatbot?.addEventListener('click', mostrarChatbot);
    btnComenzar?.addEventListener('click', mostrarChatbot);
    navInicio?.addEventListener('click', (e) => {
        e.preventDefault();
        mostrarInicio();
    });
</script>